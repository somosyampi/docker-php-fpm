+#if ZEND_MODULE_API_NO < ZEND_7_4_X_API_NO
+/* The wraprec index has 16 bits; past 0xffff it would spill into the pid. */
+static int nr_php_wraprec_vector_full(void) {
+  static int logged = 0;
 
+  if (nr_vector_size(NRPRG_SHARED(user_function_wrappers)) < 0xffff) {
+    return 0;
+  }
+  if (!logged) {
+    nrl_warning(NRL_INSTRUMENT,
+                "wraprec index space exhausted; leaving functions "
+                "uninstrumented");
+    logged = 1;
+  }
+  return 1;
+}
+#endif
+
 #define NR_PHP_UNKNOWN_FUNCTION_NAME "{unknown}"
 nruserfn_t* nr_php_add_custom_tracer_callable(zend_function* func TSRMLS_DC) {
   char* name = NULL;
