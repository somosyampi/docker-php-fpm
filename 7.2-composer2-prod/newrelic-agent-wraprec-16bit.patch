                      name);
     nr_free(name);
     return wraprec;
+  }
+
+#if ZEND_MODULE_API_NO < ZEND_7_4_X_API_NO
+  /* A full vector can't store the slot: don't leak a wraprec per call. */
+  if (nr_php_wraprec_vector_full()) {
